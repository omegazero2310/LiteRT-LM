<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- Package Information -->
    <PackageId>Google.AI.Edge.LiteRtLm</PackageId>
    <Version>1.0.0</Version>
    <Authors>Google AI Edge</Authors>
    <Company>Google LLC</Company>
    <Product>LiteRT-LM</Product>
    <Description>C# bindings for LiteRT-LM on-device language model inference library</Description>
    <Copyright>Copyright 2025 Google LLC</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/google-ai-edge/LiteRT-LM</PackageProjectUrl>
    <RepositoryUrl>https://github.com/google-ai-edge/LiteRT-LM</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;ml;llm;inference;on-device;tflite;litert</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Platform-specific native library inclusion -->
  <ItemGroup>
    <!-- Windows x64 -->
    <None Include="runtimes\win-x64\native\litertlm_csharp.dll" 
          Pack="true" 
          PackagePath="runtimes\win-x64\native\" 
          Condition="Exists('runtimes\win-x64\native\litertlm_csharp.dll')" />
    
    <!-- Windows ARM64 -->
    <None Include="runtimes\win-arm64\native\litertlm_csharp.dll" 
          Pack="true" 
          PackagePath="runtimes\win-arm64\native\" 
          Condition="Exists('runtimes\win-arm64\native\litertlm_csharp.dll')" />
    
    <!-- Linux x64 -->
    <None Include="runtimes\linux-x64\native\liblitertlm_csharp.so" 
          Pack="true" 
          PackagePath="runtimes\linux-x64\native\" 
          Condition="Exists('runtimes\linux-x64\native\liblitertlm_csharp.so')" />
    
    <!-- Linux ARM64 -->
    <None Include="runtimes\linux-arm64\native\liblitertlm_csharp.so" 
          Pack="true" 
          PackagePath="runtimes\linux-arm64\native\" 
          Condition="Exists('runtimes\linux-arm64\native\liblitertlm_csharp.so')" />
    
    <!-- macOS x64 -->
    <None Include="runtimes\osx-x64\native\litertlm_csharp.dylib" 
          Pack="true" 
          PackagePath="runtimes\osx-x64\native\" 
          Condition="Exists('runtimes\osx-x64\native\litertlm_csharp.dylib')" />
    
    <!-- macOS ARM64 -->
    <None Include="runtimes\osx-arm64\native\litertlm_csharp.dylib" 
          Pack="true" 
          PackagePath="runtimes\osx-arm64\native\" 
          Condition="Exists('runtimes\osx-arm64\native\litertlm_csharp.dylib')" />
  </ItemGroup>

  <!-- Copy native libraries to output directory for development -->
  <ItemGroup>
    <Content Include="runtimes\**\*.*" 
             CopyToOutputDirectory="PreserveNewest" 
             Link="%(RecursiveDir)%(Filename)%(Extension)" 
             Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>$(AssemblyName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

<PropertyGroup>
  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
</PropertyGroup>

<ItemGroup>
  <None Include="..\prebuild\linux_x86_64\*.so" 
        Pack="true" 
        PackagePath="runtimes\linux-x64\native\" 
        Condition="Exists('..\prebuild\linux_x86_64\')" />
  
  <None Include="..\prebuild\linux_arm64\*.so" 
        Pack="true" 
        PackagePath="runtimes\linux-arm64\native\" 
        Condition="Exists('..\prebuild\linux_arm64\')" />

  <None Include="..\prebuild\windows_x86_64\*.dll" 
        Pack="true" 
        PackagePath="runtimes\win-x64\native\" 
        Condition="Exists('..\prebuild\windows_x86_64\')" />

  <None Include="..\prebuild\macos_arm64\*.dylib" 
        Pack="true" 
        PackagePath="runtimes\osx-arm64\native\" 
        Condition="Exists('..\prebuild\macos_arm64\')" />
</ItemGroup>

</Project>
